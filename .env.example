# Application
NODE_ENV=development
PORT=3000

# Database — matches the service defined in docker-compose.yml
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nlp_to_sql
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Schema introspection
# Comma-separated Postgres schemas to expose to the NL-to-SQL pipeline.
INTROSPECTION_SCHEMAS=public
# Seconds a cached schema snapshot stays fresh; 0 disables caching.
INTROSPECTION_CACHE_TTL=300
