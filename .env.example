# Application
NODE_ENV=development
PORT=3000

# Database — matches the service defined in docker-compose.yml
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nlp_to_sql
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Schema introspection
# Comma-separated Postgres schemas to expose to the NL-to-SQL pipeline.
INTROSPECTION_SCHEMAS=public
# Seconds a cached schema snapshot stays fresh; 0 disables caching.
INTROSPECTION_CACHE_TTL=300

# Language model
# `stub` returns a canned, deterministic answer and needs no credentials, so the
# service runs out of the box. Switch to `anthropic` and set the key below for
# real generation.
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=16000
# low | medium | high | xhigh | max — thinking depth and token spend.
LLM_EFFORT=high

# Conversations (in-memory; these bound how much memory one instance can use)
# Seconds a conversation survives without activity.
CONVERSATION_TTL=3600
# Turns kept per conversation — older turns drop out of the prompt.
CONVERSATION_MAX_TURNS=20
# Conversations held before the least recently used are evicted.
CONVERSATION_MAX_SESSIONS=1000

# Query safety
# Hard ceiling on rows a generated query may return; enforced by rewriting the
# query, not by trusting the model to add a LIMIT.
SQL_MAX_ROWS=500
# Comma-separated table names. Empty allow list = every introspected table.
SQL_ALLOWED_TABLES=
SQL_DENIED_TABLES=
